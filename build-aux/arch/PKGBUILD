# SPDX-License-Identifier: GPL-3.0-or-later
# Arch Linux / AUR. Sources from scripts/dist.sh (vendored crates: offline build).
pkgname=transom
pkgver=0.0.1
pkgrel=1
pkgdesc="Sharp remote desktops over RDP (GTK 4, HiDPI-correct)"
arch=(x86_64 aarch64)
url="https://github.com/jm2/transom"
license=(GPL-3.0-or-later Apache-2.0)
depends=(freerdp gtk4 libadwaita libsecret hicolor-icon-theme ffmpeg)
optdepends=('libva-mesa-driver: hardware H.264 decoding on AMD (zero-copy video)'
            'intel-media-driver: hardware H.264 decoding on Intel (zero-copy video)'
            'vulkan-icd-loader: GTK''s Vulkan renderer, needed to show hardware-decoded video')
makedepends=(cargo clang)
source=("$pkgname-$pkgver.tar.gz" "$pkgname-$pkgver-vendor.tar.xz")
sha256sums=(SKIP SKIP)

prepare() {
  cd "$pkgname-$pkgver"
  mv ../vendor .
  mkdir -p .cargo
  printf '[source.crates-io]\nreplace-with = "vendored-sources"\n[source.vendored-sources]\ndirectory = "vendor"\n' > .cargo/config.toml
}

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked --offline -p transom
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --release --locked --offline -p transom-view-core
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/transom "$pkgdir/usr/bin/transom"
  install -Dm644 data/io.github.jm2.Transom.desktop "$pkgdir/usr/share/applications/io.github.jm2.Transom.desktop"
  install -Dm644 data/io.github.jm2.Transom.metainfo.xml "$pkgdir/usr/share/metainfo/io.github.jm2.Transom.metainfo.xml"
  install -Dm644 data/io.github.jm2.Transom.mime.xml "$pkgdir/usr/share/mime/packages/io.github.jm2.Transom.xml"
  install -Dm644 data/icons/hicolor/scalable/apps/io.github.jm2.Transom.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.jm2.Transom.svg"
  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}
