# Throwaway MIT Kerberos KDC for realm TRANSOM.TEST (Kerberos NLA tests).
FROM registry.fedoraproject.org/fedora:45
RUN dnf install -y --setopt=install_weak_deps=False krb5-server krb5-workstation && dnf clean all
COPY krb5.conf /etc/krb5.conf
COPY kdc.conf /var/kerberos/krb5kdc/kdc.conf
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh
EXPOSE 88
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
