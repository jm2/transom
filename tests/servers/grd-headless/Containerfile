# Throwaway gnome-remote-desktop (headless mode) test server.
# Software rendering (llvmpipe); no GPU or host session needed.
# libavcodec-free: the client examples run here link it (ADR 0006); Fedora's build
# has no native H.264 decoder, so hardware decoding stays off (see ../hwdec).
FROM registry.fedoraproject.org/fedora:45

RUN dnf install -y --setopt=install_weak_deps=False \
        gnome-shell gnome-remote-desktop mutter \
        pipewire wireplumber pipewire-pulseaudio pulseaudio-utils \
        mesa-dri-drivers mesa-libEGL \
        dbus-daemon dbus-tools openssl procps-ng \
        adwaita-sans-fonts adwaita-mono-fonts adwaita-icon-theme \
        gnome-text-editor loupe python3-gobject python3-pyatspi \
        libavcodec-free libavutil-free \
    && dnf clean all

RUN useradd -m -u 1000 rdp
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
COPY probe/input-probe.py /usr/local/bin/input-probe
RUN chmod 755 /usr/local/bin/entrypoint.sh /usr/local/bin/input-probe

USER rdp
ENV XDG_RUNTIME_DIR=/tmp/xdg-runtime \
    LIBGL_ALWAYS_SOFTWARE=1
EXPOSE 3389
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
